DATABASE_URL=postgresql+psycopg://stay:stay_dev_password@localhost:5434/stay_direct
# Generar uno propio con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-genera-tu-propio-secreto
# Credenciales del admin inicial que crea el script de seed.
ADMIN_EMAIL=admin@staydirect.com
ADMIN_PASSWORD=changeme

# Réplicas del servicio de precios, vistas desde FUERA de Docker (backend local).
# 127.0.0.1 y no localhost: en Windows localhost resuelve primero a ::1 y Docker
# publica estos puertos en IPv4.
# Dentro de Docker esto NO aplica: docker-compose.yml lo pisa con los nombres de
# servicio (http://ml-service-1:8001).
ML_SERVICE_URLS=http://127.0.0.1:8001,http://127.0.0.1:8002
